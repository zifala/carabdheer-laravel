parameters:
    level: 7
    paths:
        - src
        - config/carabdheer.php
    tmpDir: build/phpstan
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/carabdheer.php
        -
            identifier: instanceof.alwaysFalse
            path: src/CarabdheerServiceProvider.php
